# The Checker worker's settings. Copy this file to ".env" in the same folder
# and fill in the two values marked FILL IN. Never commit ".env".

# FILL IN: the Anthropic API key (console.anthropic.com > API keys). Pays for the checking.
ANTHROPIC_API_KEY=

# FILL IN: the Supabase secret key (Supabase dashboard > Project Settings > API Keys > secret key).
# Lets the worker read waiting checks and write results. Never put it in the app.
SUPABASE_SERVICE_ROLE_KEY=

# Read automatically from the app's own files on this PC, no need to copy:
#   SUPABASE URL       from D:\Deeni\mobile\.env (EXPO_PUBLIC_SUPABASE_URL)
#   YOUTUBE_API_KEY    from D:\Deeni\mobile\.env
#   GEMINI_API_KEY     from D:\Deeni\.env
# Set them here only to override.
